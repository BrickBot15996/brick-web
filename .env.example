# ---------------------------------------------------------------------------
# brick-web environment variables
#
# Copy this file to `.env` (same folder, the repo root) and paste values there.
# `.env` is git-ignored. NEVER put real values in this template.
#
# One root `.env` feeds every app in the monorepo locally. Each app only
# exposes the PUBLIC values to the browser; secret values are used only by
# Supabase Edge Functions, the scheduler Worker and local scripts.
#
# Markers:  [public]  safe to ship to browsers
#           [SECRET]  server-side only, never in frontend code
# Steps refer to SETUP.md.
# ---------------------------------------------------------------------------


# === Supabase ==============================================================
# SETUP.md → Supabase → "Create the project" (Project Settings → API)

# [public] Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# [public] anon / publishable key
SUPABASE_ANON_KEY=
# [SECRET] service_role / secret key. Bypasses all security. Edge Functions only.
SUPABASE_SERVICE_ROLE_KEY=
# [SECRET] project ref (the id in the dashboard URL), used by the Supabase CLI to link
SUPABASE_PROJECT_REF=
# [SECRET] database password chosen at project creation (CLI migrations)
SUPABASE_DB_PASSWORD=


# === Cloudflare account ====================================================
# SETUP.md → Cloudflare → "Account ID"

# [SECRET] not dangerous on its own, but keep it out of frontends
CLOUDFLARE_ACCOUNT_ID=


# === Cloudflare R2 (CDN uploads) ===========================================
# SETUP.md → Cloudflare → "R2 API token"

# [SECRET]
R2_ACCESS_KEY_ID=
# [SECRET]
R2_SECRET_ACCESS_KEY=
# [SECRET] e.g. https://<account-id>.r2.cloudflarestorage.com
R2_S3_ENDPOINT=
# [SECRET] name of the CDN bucket
R2_BUCKET_NAME=
# [public] public base URL of the bucket
CDN_URL=https://cdn.brickbot.ro


# === Cloudflare Turnstile (contact form) ===================================
# SETUP.md → Cloudflare → "Turnstile"

# The real widget only allows brickbot.ro. For local development, use Cloudflare's
# dummy keys instead (they work on localhost): the form then always passes.
#   site key   1x00000000000000000000AA
#   secret key 1x0000000000000000000000000000000AA
# Local dev values live in the git-ignored .env; use the real keys only in production.

# [public] site key, used by the website form
TURNSTILE_SITE_KEY=
# [SECRET] secret key, used by the contact Edge Function
TURNSTILE_SECRET_KEY=


# === Cloudflare Web Analytics ==============================================
# SETUP.md → Cloudflare → "Web Analytics". Leave empty if Cloudflare injects
# the script automatically and shows no token.

# [public]
CF_WEB_ANALYTICS_TOKEN_WEBSITE=
# [public]
CF_WEB_ANALYTICS_TOKEN_LINKS=


# === Resend (email) ========================================================
# SETUP.md → Email → "Create an API key"
# (The same key is also pasted into Supabase's SMTP settings in the dashboard.)

# [SECRET]
RESEND_API_KEY=
# [SECRET] sender for contact form emails
CONTACT_FROM_EMAIL=BrickBot Website <noreply@brickbot.ro>
# [SECRET] contact form recipient (department CCs are defined in code)
CONTACT_TO_EMAIL=contact@brickbot.ro


# === Google Maps ===========================================================
# SETUP.md → Google. Will be moved into the CMS site settings once it exists;
# kept here so the design can be previewed before then.

# [public] the iframe `src` URL from "Embed a map"
GOOGLE_MAPS_EMBED_URL=
# [public] the "Send a link" URL
GOOGLE_MAPS_LINK_URL=


# === Cloudflare deploy hooks (later) =======================================
# SETUP.md → "Later" → "Deploy hooks". Used by the CMS Publish Edge Function
# and the scheduler Worker.

# [SECRET]
DEPLOY_HOOK_WEBSITE=
# [SECRET]
DEPLOY_HOOK_LINKS=


# === App URLs ==============================================================
# [public] production URLs. Local dev overrides these automatically.
SITE_URL=https://brickbot.ro
LINKS_URL=https://links.brickbot.ro
CMS_URL=https://cms.brickbot.ro
AUTH_URL=https://auth.brickbot.ro
