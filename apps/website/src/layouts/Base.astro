---
import '../styles/global.css';
import '../styles/pages.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { routes, type Locale, type RouteId } from '../lib/site';
import { copy } from '../lib/copy';
import { cdn } from '../lib/cdn';

interface Props { locale: Locale; route: RouteId; title?: string; description?: string; paths?: Record<Locale, string>; image?: string; noindex?: boolean }
const { locale, route, title, description, paths: pathsProp, image, noindex } = Astro.props;
const paths = pathsProp ?? routes[route];
const t = copy[locale];
const site = Astro.site ?? new URL('https://brickbot.ro');
const abs = (p: string) => new URL(p, site).href;
const other: Locale = locale === 'en' ? 'ro' : 'en';
const pageTitle = title ?? t.meta.title;
const pageDesc = description ?? t.meta.description;
const og = abs(cdn(image ?? 'brand/og-default.jpg'));
---
<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={abs(paths[locale])} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="en" href={abs(paths.en)} />
    <link rel="alternate" hreflang="ro" href={abs(paths.ro)} />
    <link rel="alternate" hreflang="x-default" href={abs(paths.en)} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={cdn('brand/logo.svg')} type="image/svg+xml" />
    <link rel="preload" href="/fonts/anek-latin-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anek-latin-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BrickBot" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={abs(paths[locale])} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={locale === 'en' ? 'en_GB' : 'ro_RO'} />
    <meta property="og:locale:alternate" content={other === 'en' ? 'en_GB' : 'ro_RO'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body style={`--wordmark: url(${cdn('brand/wordmark.svg')}); --logomark: url(${cdn('brand/logo.svg')})`}>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Nav locale={locale} route={route} paths={paths} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="close" />
    <Footer locale={locale} />
    <Lightbox locale={locale} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
