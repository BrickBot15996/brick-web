---
/** Section heading with an optional lede set beside it on wide screens. */
interface Props { id: string; title: string; lede?: string; size?: 'lg' | 'md' }
const { id, title, lede, size = 'lg' } = Astro.props;
---
<div class="sechead">
  <h2 id={id} class={`h-${size} sechead__h`} data-reveal>{title}</h2>
  {lede && <p class="lead sechead__lede">{lede}</p>}
  <slot />
</div>
