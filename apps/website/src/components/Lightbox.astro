---
/** One shared lightbox dialog per page, driven by `[data-lightbox]` triggers (see scripts/site.ts). */
import type { Locale } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = {
  en: { label: 'Photo viewer', close: 'Close', prev: 'Previous photo', next: 'Next photo' },
  ro: { label: 'Vizualizator foto', close: 'Închide', prev: 'Fotografia anterioară', next: 'Fotografia următoare' },
}[locale];
---
<dialog class="lightbox" data-lightbox-dialog aria-label={t.label}>
  <figure class="lightbox__fig"><div class="lightbox__media" data-lightbox-media></div><figcaption data-lightbox-cap></figcaption></figure>
  <button class="lightbox__btn lightbox__close" type="button" data-lightbox-close aria-label={t.close}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5 12.5 12.5M12.5 3.5 3.5 12.5" /></svg></button>
  <button class="lightbox__btn lightbox__prev" type="button" data-lightbox-step="-1" aria-label={t.prev}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg></button>
  <button class="lightbox__btn lightbox__next" type="button" data-lightbox-step="1" aria-label={t.next}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg></button>
</dialog>
