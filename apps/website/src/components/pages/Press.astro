---
import PageHead from '../PageHead.astro';
import SecHead from '../SecHead.astro';
import Img from '../Img.astro';
import Arrow from '../Arrow.astro';
import { routes, site, type Locale } from '../../lib/site';
import { cdn } from '../../lib/cdn';
interface Props { locale: Locale }
const { locale } = Astro.props;

// Descriptions are given in both languages on both pages: journalists often need the other one.
const descriptions = {
  short: {
    en: 'BrickBot (FTC team #15996) is the FIRST Tech Challenge robotics team from Focșani, Romania, with members mainly from “Unirea” National College. Founded in 2016 as the first FTC team in Vrancea county, it finished the 2025⁠–⁠26 season in the world’s top 10 and as a division finalist at the FIRST Championship in Houston.',
    ro: 'BrickBot (echipa FTC #15996) este echipa de robotică FIRST Tech Challenge din Focșani, România, cu membri în principal de la Colegiul Național „Unirea”. Înființată în 2016 ca prima echipă FTC din județul Vrancea, a încheiat sezonul 2025⁠–⁠26 în top 10 mondial și ca finalistă de divizie la Campionatul Mondial FIRST din Houston.',
  },
  long: {
    en: 'BrickBot (FTC team #15996) is the FIRST Tech Challenge robotics team from Focșani, Romania, with members mainly from “Unirea” National College, and the first FTC team in Vrancea county. Since 2016, its high-school students have designed, built and programmed a new competition robot every season, and run everything around it themselves: events, graphic design, photo and video, social media and fundraising.\n\nIn the 2025⁠–⁠26 DECODE season the team reached the FIRST Championship in Houston, where it was a division finalist alliance and won 2nd place for the Design Award, finishing the season in the world’s top 10. Earlier results include the SparkHope Robotics Cup title (2025), the Innovate Award, 2nd place, at the Italy Championship (2025) and an Inspire Award in Romania (2021).\n\nThe team also teaches robotics in Focșani primary schools and runs stands at public events. It is run legally by Asociația BrickBot, a Romanian NGO (CIF 50846996).',
    ro: 'BrickBot (echipa FTC #15996) este echipa de robotică FIRST Tech Challenge din Focșani, România, cu membri în principal de la Colegiul Național „Unirea”, și prima echipă FTC din județul Vrancea. Din 2016, liceenii din echipă proiectează, construiesc și programează în fiecare sezon un robot de competiție nou și se ocupă singuri de tot ce ține de el: evenimente, design grafic, foto-video, social media și strângere de fonduri.\n\nÎn sezonul 2025⁠–⁠26 DECODE, echipa a ajuns la Campionatul Mondial FIRST din Houston, unde a fost alianță finalistă a diviziei și a câștigat locul 2 la Design Award, încheind sezonul în top 10 mondial. Printre rezultatele anterioare se numără titlul la SparkHope Robotics Cup (2025), locul 2 la Innovate Award la Campionatul Italiei (2025) și un Inspire Award în România (2021).\n\nEchipa predă și robotică în școlile primare din Focșani și are standuri la evenimente publice. Din punct de vedere legal, este administrată de Asociația BrickBot, ONG înregistrat în România (CIF 50846996).',
  },
};
const logos = [
  { key: 'brand/logo.svg', en: 'Logo mark', ro: 'Simbol', w: 326, h: 232 },
  { key: 'brand/wordmark.svg', en: 'Wordmark', ro: 'Wordmark', w: 1115, h: 217 },
  { key: 'brand/lockup.svg', en: 'Logo and wordmark', ro: 'Simbol și wordmark', w: 1115, h: 217 },
];
const photos = [
  { key: 'site/home/hero.webp', w: 1616, h: 1080, en: 'Celebrating at the 2026 Romania National Championship', ro: 'Bucurie la Campionatul Național 2026' },
  { key: 'seasons/decode/team-photo.webp', w: 960, h: 640, en: 'The team at the 2026 FIRST Championship', ro: 'Echipa la Campionatul Mondial FIRST 2026' },
  { key: 'gallery/decode/worlds-practice-field.webp', w: 1600, h: 1069, en: 'The DECODE robot on a practice field in Houston', ro: 'Robotul DECODE pe un teren de antrenament în Houston' },
  { key: 'seasons/biobuzz/team-photo.webp', w: 1600, h: 1066, en: 'The 2026⁠–⁠27 team', ro: 'Echipa 2026⁠–⁠27' },
];
const t = {
  en: {
    title: 'Press kit.',
    lede: 'Logos, photos and ready-to-use descriptions of the team. Everything here is free to use in coverage of BrickBot.',
    contact: 'Press questions? Write to us', descH: 'About the team', short: 'Short description', long: 'Long description',
    copy: 'Copy', copied: 'Copied', inEn: 'English', inRo: 'Romanian',
    logosH: 'Logos', logosLede: 'SVG, on any dark background. Please don’t recolour, stretch or redraw them.', download: 'Download',
    photosH: 'Photos',
    factsH: 'Fast facts',
    facts: [['Team', 'BrickBot, FIRST Tech Challenge #15996'], ['Founded', '2016, the first FTC team in Vrancea county'], ['School', '“Unirea” National College, Focșani'], ['2025⁠–⁠26', 'FIRST Championship division finalists · Design Award, 2nd place · top 10 in the world'], ['Legal entity', 'Asociația BrickBot, CIF 50846996'], ['Contact', site.email]],
  },
  ro: {
    title: 'Kit de presă.',
    lede: 'Logo-uri, fotografii și descrieri ale echipei gata de folosit. Tot ce e aici poate fi folosit liber în articolele despre BrickBot.',
    contact: 'Întrebări de presă? Scrie-ne', descH: 'Despre echipă', short: 'Descriere scurtă', long: 'Descriere lungă',
    copy: 'Copiază', copied: 'Copiat', inEn: 'Engleză', inRo: 'Română',
    logosH: 'Logo-uri', logosLede: 'SVG, pe orice fundal închis. Te rugăm să nu le recolorezi, să nu le deformezi și să nu le redesenezi.', download: 'Descarcă',
    photosH: 'Fotografii',
    factsH: 'Pe scurt',
    facts: [['Echipa', 'BrickBot, FIRST Tech Challenge #15996'], ['Înființată', '2016, prima echipă FTC din județul Vrancea'], ['Școala', 'Colegiul Național „Unirea”, Focșani'], ['2025⁠–⁠26', 'Finaliști de divizie la Campionatul Mondial FIRST · Design Award, locul 2 · top 10 mondial'], ['Entitate juridică', 'Asociația BrickBot, CIF 50846996'], ['Contact', site.email]],
  },
}[locale];
const order: Locale[] = locale === 'en' ? ['en', 'ro'] : ['ro', 'en'];
const langName = (l: Locale) => (l === 'en' ? t.inEn : t.inRo);
---
<PageHead locale={locale} title={t.title} lede={t.lede} compact>
  <Fragment slot="actions"><a class="btn btn--ghost" href={`${routes.contact[locale]}?dept=pr`}>{t.contact}<Arrow /></a></Fragment>
</PageHead>

<section class="sec sec--tight" aria-labelledby="facts-h">
  <div class="wrap split">
    <div class="sechead"><h2 id="facts-h" class="h-lg sechead__h">{t.factsH}</h2></div>
    <dl class="facts-list">{t.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
  </div>
</section>

<section class="sec" aria-labelledby="desc-h">
  <div class="wrap">
    <div class="sechead"><h2 id="desc-h" class="h-lg sechead__h">{t.descH}</h2></div>
    <div class="descs">
      {(['short', 'long'] as const).map((len) => order.map((l) => (
        <article class="desc board" lang={l}>
          <header class="desc__head"><h3>{len === 'short' ? t.short : t.long} · {langName(l)}</h3>
            <button class="btn btn--sm btn--ghost" type="button" data-copy={descriptions[len][l]} data-copied={t.copied}>{t.copy}</button>
            <span class="sr-only" aria-live="polite" data-copy-status></span>
          </header>
          {descriptions[len][l].split('\n\n').map((p) => <p>{p}</p>)}
        </article>
      )))}
    </div>
  </div>
</section>

<section class="sec" aria-labelledby="logos-h">
  <div class="wrap">
    <SecHead id="logos-h" title={t.logosH} lede={t.logosLede} />
    <ul class="kit">
      {logos.map((l) => (
        <li class="kit__item board">
          <span class="kit__art"><img src={cdn(l.key)} alt="" width={l.w} height={l.h} loading="lazy" /></span>
          <span class="kit__foot"><span>{l[locale]}</span><a class="link" href={cdn(l.key)} download>{t.download} SVG<Arrow /></a></span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="sec" aria-labelledby="photos-h">
  <div class="wrap">
    <SecHead id="photos-h" title={t.photosH} />
    <ul class="groups" data-lightbox-group>
      {photos.map((p) => (
        <li><figure class="board"><Img src={p.key} width={p.w} height={p.h} alt={p[locale]} zoom /></figure>
          <p class="groups__cap">{p[locale]} · <a href={cdn(p.key)} download>{t.download}</a></p></li>
      ))}
    </ul>
  </div>
</section>
