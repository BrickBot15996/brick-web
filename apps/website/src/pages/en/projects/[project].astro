---
import Base from '../../../layouts/Base.astro';
import Project from '../../../components/pages/Project.astro';
import { projectPages, type Project as P } from '../../../lib/projects';
import { routes } from '../../../lib/site';
export function getStaticPaths() {
  return projectPages.map((project) => ({ params: { project: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: P };
const paths = { en: `${routes.projects.en}${project.slug}/`, ro: `${routes.projects.ro}${project.slug}/` };
const title = `${project.name.en} · Projects · BrickBot`;
---
<Base locale="en" route="projects" paths={paths} title={title} description={project.summary.en}>
  <Project locale="en" project={project} />
</Base>
